# AWS Bedrock Configuration
AWS_PROFILE=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Bedrock Model Constants (Read from constants, never dynamically construct)
BEDROCK_DEFAULT_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_STRATEGIST_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_ANALYST_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# Execution Mode: Set to true for 100% offline local testing with  AWS spend
USE_STUB_MODELS=true

# Loop Bounds and Safety Limits
MAX_AGENT_RETRIES=2
MAX_GRAPH_ITERATIONS=20

# Exploration vs Exploitation Policy
DEFAULT_EXPLORE_PCT=0.30
MIN_EXPLORE_PCT=0.10

# Persistent SQLite Ledger Path
LEDGER_DB_PATH=data/traction.db
