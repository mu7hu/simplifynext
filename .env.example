# AWS Bedrock Configuration
AWS_PROFILE=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Bedrock Model Constants (Read from constants, never dynamically construct)
BEDROCK_DEFAULT_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_STRATEGIST_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# Analyst defaults to a cheap model. Options: Claude Haiku (below), or a Nova id
# such as amazon.nova-micro-v1:0 / amazon.nova-lite-v1:0.
BEDROCK_ANALYST_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
# Escalation model used only when ANALYST_USE_ESCALATION=true.
BEDROCK_ANALYST_ESCALATION_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
ANALYST_USE_ESCALATION=false

# Content Generator Agent (cheap by default; escalate behind the flag).
BEDROCK_CONTENT_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_CONTENT_ESCALATION_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
CONTENT_USE_ESCALATION=false
CONTENT_VARIANTS_PER_CHANNEL=3

# Execution Mode: Set to true for 100% offline local testing with  AWS spend
USE_STUB_MODELS=true

# Loop Bounds and Safety Limits
MAX_AGENT_RETRIES=2
MAX_GRAPH_ITERATIONS=20

# Exploration vs Exploitation Policy
DEFAULT_EXPLORE_PCT=0.30
MIN_EXPLORE_PCT=0.10

# Persistent SQLite Ledger Path
LEDGER_DB_PATH=data/traction.db
